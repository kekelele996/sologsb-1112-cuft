{
  "name": "gbbirdring-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 21812",
    "test:merge": "node -e \"const esbuild=require('esbuild');esbuild.build({entryPoints:['scripts/merge-core.test.ts'],bundle:true,platform:'node',format:'cjs',outfile:'scripts/.merge-core.test.cjs'}).then(()=>{require('./scripts/.merge-core.test.cjs')}).catch(e=>{console.error(e);process.exit(1)})\" && node -e \"require('fs').rmSync('scripts/.merge-core.test.cjs')\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dexie": "^4.0.11",
    "element-plus": "^2.9.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
